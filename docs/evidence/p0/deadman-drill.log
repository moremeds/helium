##[group]Run bash scripts/deadman/check-heartbeat.test.sh
bash scripts/deadman/check-heartbeat.test.sh
shell: /usr/bin/bash -e {0}
env:
  PNPM_HOME: /home/runner/setup-pnpm/node_modules/.bin
##[endgroup]
case 1: no heartbeat file at all -> 10
case 2: immediately again -> 11 (6h dedup)
case 3: fresh heartbeat -> 0 and sentinel cleared
case 4: 20-minute-old heartbeat -> 10
case 5: jsonl/ subdirectory never created (state root exists, jsonl/ does not) -> 10, not a crash
case 6: process alive but a SECOND tenant silent -> 13, naming only that tenant
case 7: immediately again -> 14 (tenant dedup, separate sentinel)
case 8: a malformed tenant stays visible as invalid rather than vanishing
mail log:
--env-file /tmp/helium-deadman-test.JLNKfS/helium.env --subject [helium] heartbeat stale since (no heartbeat file) --body-file /tmp/helium-deadman.ywrCKq
--env-file /tmp/helium-deadman-test.JLNKfS/helium.env --subject [helium] heartbeat stale since 2026-08-29T02:33:45Z --body-file /tmp/helium-deadman.RRuOWn
--env-file /tmp/helium-deadman-test.JLNKfS/helium.env --subject [helium] tenant heartbeat missing --body-file /tmp/helium-deadman-tenant.m3xytF
--env-file /tmp/helium-deadman-test.JLNKfS/helium.env --subject [helium] tenant heartbeat missing --body-file /tmp/helium-deadman-tenant.Dx95cU
ALL PASS
