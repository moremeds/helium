##[group]Run set -eu
set -eu
for pkg in fake-metered fake-flat-rate; do
  echo "--- @helium/$pkg: remove ---"
  pnpm --filter @helium/contracts remove "@helium/$pkg"
  echo "--- @helium/$pkg: add back ---"
  pnpm --filter @helium/contracts add -D "@helium/$pkg@file:../packages/$pkg"
done
changed=$(git diff --name-only -- packages/core plugins/helium)
if [ -n "$changed" ]; then
  echo "FAIL: install/removal edited core or the plugin:"
  echo "$changed"
  exit 1
fi
echo "PASS: packages/core and plugins/helium unchanged"
shell: /usr/bin/bash -e {0}
env:
  PNPM_HOME: /home/runner/setup-pnpm/node_modules/.bin
##[endgroup]
