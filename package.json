    "test:livewire-deploy": "node scripts/ops/run-livewire-deploy-gate.mjs",
    "test:e2e-local": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "nodemailer": "9.0.5",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@types/semver": "^7.8.0",
    "typescript": "^5",
    "vitest": "^3"
  }
