<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.helium.livewire-opsd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RELEASE__/scripts/ops/run-livewire-opsd.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__RELEASE__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__NODE_BIN_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>HELIUM_NODE_BIN</key><string>__NODE_BIN__</string>
    <key>HELIUM_NODE_RUNTIME_MANIFEST</key><string>__NODE_RUNTIME_MANIFEST__</string>
    <key>HELIUM_NODE_RUNTIME_MANIFEST_SHA256</key><string>__NODE_RUNTIME_MANIFEST_SHA256__</string>
    <key>HELIUM_LIVEWIRE_OPS_CONFIG</key><string>__OPS_CONFIG__</string>
    <key>HELIUM_SHEPHERD_CONFIG</key><string>__SHEPHERD_CONFIG__</string>
    <key>HELIUM_OPSD_LOG_ROOT</key><string>__LOG_ROOT__</string>
  </dict>
</dict>
</plist>
