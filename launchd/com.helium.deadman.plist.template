<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Placeholders, substituted by the operator when installing this plist:
       __RELEASE__       the immutable release dir, e.g. ~/projects/helium-releases/current
       __HOME__          the operator account's home directory
       __NODE_BIN_DIR__  the directory holding `node`, e.g. /opt/homebrew/bin
       __EMAIL_TO__      where alerts are delivered
     Substitution is BY HAND here, unlike the opsd templates: no script installs
     this label, so nothing enforces that every placeholder was resolved.
     (scripts/ops/install-observe-only.sh has such a guard — it throws on any
     remaining /__[A-Z0-9_]+__/ — but it only installs com.helium.opsd and
     com.helium.opsd-deadman.) Before `launchctl bootstrap`, check yourself:
       grep -o '__[A-Z0-9_]*__' com.helium.deadman.plist   # must print nothing -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.helium.deadman</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RELEASE__/scripts/deadman/check-heartbeat.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.helium/logs/deadman.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.helium/logs/deadman.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__NODE_BIN_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>HELIUM_NODE_BIN</key><string>__NODE_BIN_DIR__/node</string>
    <key>HELIUM_STATE_ROOT</key><string>__HOME__/.helium/state</string>
    <key>HELIUM_ENV_FILE</key><string>__HOME__/.config/helium/helium.env</string>
    <!-- Mirrors com.helium.dsh.plist: the recipient is plist-supplied, not a
         secret in the 0600 env file. Without it here the watchdog detects a
         stale heartbeat and then dies at exit 12 with "missing config keys"
         (found by the 3.4 live drill) — send-alert.mjs now falls back to the
         process environment, and this is what fills it. -->
    <key>HELIUM_EMAIL_TO</key><string>__EMAIL_TO__</string>
  </dict>
</dict>
</plist>
