{
  "name": "helium-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Helium distribution layer for DeepSeek Harness: runner, agent tasks, audit, ledger, as-of, delivery. No business words.",
  "exports": {
    ".": "./lib/index.js",
    "./runner": "./lib/runner.js"
  },
  "files": ["lib", "cordis.patch.yml"],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
