#!/bin/bash
set -euo pipefail
umask 077

readonly ready_dir='__READY_DIR__'
readonly python_bin='__PYTHON_BIN__'
readonly python_sha256='__PYTHON_SHA256__'
readonly livewire_root='__LIVEWIRE_ROOT__'
readonly source_manifest='__SOURCE_MANIFEST__'
readonly source_manifest_sha256='__SOURCE_MANIFEST_SHA256__'
readonly python_runtime_manifest='__PYTHON_RUNTIME_MANIFEST__'
readonly python_runtime_manifest_sha256='__PYTHON_RUNTIME_MANIFEST_SHA256__'
readonly data_lake_root='__DATA_LAKE_ROOT__'
readonly command='__COMMAND__'
readonly child_timeout_seconds='__CHILD_TIMEOUT_SECONDS__'

fail() {
  printf 'livewire repair wrapper refused: %s\n' "$1" >&2
  exit 64
}

if [ "$command" = "transaction" ]; then
  IFS= read -r execution_gate <&3 || fail "execution gate closed before child lock adoption"
  [ "$execution_gate" = "go" ] || fail "invalid execution gate"
  exec 3<&-
fi

[ "$#" -eq 2 ] && [ "$1" = "--manifest" ] || fail "expected only --manifest ABS"
manifest="$2"
case "$manifest" in
  /*) ;;
  *) fail "manifest path is not absolute" ;;
esac
[ ! -L "$manifest" ] && [ -f "$manifest" ] || fail "manifest is not a regular nonsymlink file"
[ "$(/usr/bin/stat -f '%u' "$manifest")" = "$(/usr/bin/id -u)" ] || fail "manifest owner differs from daemon user"
[ "$(/usr/bin/stat -f '%Lp' "$manifest")" = "600" ] || fail "manifest mode is not 0600"
resolved_ready="$(cd "$ready_dir" && pwd -P)"
resolved_parent="$(cd "$(dirname "$manifest")" && pwd -P)"
[ "$resolved_parent" = "$resolved_ready" ] || fail "manifest is outside the signed ready directory"
name="$(basename "$manifest")"
[[ "$name" =~ ^sha256:[0-9a-f]{64}\.json$ ]] || fail "manifest filename is not content-addressed"

[ "$([[ -x "$python_bin" ]] && /usr/bin/shasum -a 256 "$python_bin" | /usr/bin/awk '{print $1}')" = "$python_sha256" ] ||
  fail "pinned Python identity changed"
[ "$([[ -f "$python_runtime_manifest" ]] && [ ! -L "$python_runtime_manifest" ] && \
  /usr/bin/shasum -a 256 "$python_runtime_manifest" | /usr/bin/awk '{print $1}')" = "$python_runtime_manifest_sha256" ] ||
  fail "Python runtime manifest changed"
(cd / && /usr/bin/shasum -a 256 -c "$python_runtime_manifest" >/dev/null) ||
  fail "pinned Python runtime bytes changed"
[ "$([[ -f "$source_manifest" ]] && /usr/bin/shasum -a 256 "$source_manifest" | /usr/bin/awk '{print $1}')" = "$source_manifest_sha256" ] ||
  fail "Livewire source manifest changed"
[ ! -L "$livewire_root/livewire_scripts" ] && [ ! -L "$livewire_root/clients" ] ||
  fail "Livewire Python source root is a symlink"
[ -z "$(/usr/bin/find "$livewire_root" -maxdepth 1 \( -type f -o -type l \) -name '*.py' -print -quit)" ] ||
  fail "unsafe Python import shadow exists at Livewire root"
[ -z "$(/usr/bin/find "$livewire_root/livewire_scripts" "$livewire_root/clients" -type l -print -quit)" ] ||
  fail "Livewire Python runtime contains a symlink"
[ -z "$(/usr/bin/find "$livewire_root/livewire_scripts" "$livewire_root/clients" \
  \( -type d -name '__pycache__' -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) -print -quit)" ] ||
  fail "unsigned Python bytecode exists in Livewire runtime"
declared_python="$(/usr/bin/awk '{ path=$2; sub(/^\*/, "", path); if (path ~ /\.py$/) print path }' "$source_manifest" | LC_ALL=C /usr/bin/sort -u)"
actual_python="$(cd "$livewire_root" && /usr/bin/find livewire_scripts clients -type f -name '*.py' ! -path '*/__pycache__/*' -print | LC_ALL=C /usr/bin/sort -u)" ||
  fail "cannot enumerate Livewire Python runtime"
missing_python="$(/usr/bin/comm -23 <(/usr/bin/printf '%s\n' "$actual_python") <(/usr/bin/printf '%s\n' "$declared_python"))"
[ -z "$missing_python" ] || fail "Livewire source manifest omits Python runtime files"
(cd "$livewire_root" && /usr/bin/shasum -a 256 -c "$source_manifest" >/dev/null) ||
  fail "pinned Livewire source bytes changed"

readonly python_entrypoint='import runpy,sys; root=sys.argv.pop(1); sys.path.append(root); sys.argv[0]="livewire_scripts.shepherd_repair"; runpy.run_module("livewire_scripts.shepherd_repair", run_name="__main__")'
cd /

if [ "$command" != "transaction" ]; then
  exec "$python_bin" -I -B -s -E -c "$python_entrypoint" "$livewire_root" \
    --data-lake-root "$data_lake_root" "$command" --manifest "$manifest"
fi

[[ "$child_timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail "invalid child timeout"

# The wrapper is the OS-lock holder adopted by opsd.  It intentionally remains
# alive as the transaction supervisor so its deadline survives an opsd crash.
child_pid=0
watchdog_pid=0
cleanup_children() {
  if [ "$watchdog_pid" -gt 0 ]; then
    /bin/kill -TERM "$watchdog_pid" 2>/dev/null || true
  fi
  if [ "$child_pid" -gt 0 ]; then
    /bin/kill -TERM "$child_pid" 2>/dev/null || true
  fi
}
trap cleanup_children HUP INT TERM EXIT

"$python_bin" -I -B -s -E -c "$python_entrypoint" "$livewire_root" \
  --data-lake-root "$data_lake_root" "$command" --manifest "$manifest" &
child_pid=$!
readonly python_watchdog='import os,signal,sys,time; pid=int(sys.argv[1]); pgid=os.getpgid(pid); time.sleep(int(sys.argv[2]));
def send(sig):
 try:
  if os.getpgid(pid) != pgid: return False
  os.kill(pid,sig); return True
 except ProcessLookupError: return False
if send(signal.SIGTERM): time.sleep(5); send(signal.SIGKILL)'
"$python_bin" -I -B -s -E -c "$python_watchdog" "$child_pid" "$child_timeout_seconds" &
watchdog_pid=$!

set +e
wait "$child_pid"
child_rc=$?
/bin/kill -TERM "$watchdog_pid" 2>/dev/null || true
wait "$watchdog_pid" 2>/dev/null
set -e
child_pid=0
watchdog_pid=0
trap - HUP INT TERM EXIT

case "$child_rc" in
  137|143) exit 124 ;;
  *) exit "$child_rc" ;;
esac
