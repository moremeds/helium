node_modules/
lib/
dist/
*.env
.DS_Store
state/
*.tsbuildinfo
.worktrees/

# Playwright MCP scratch output (console logs, screenshots) from UI verification runs
# Point-in-time operator handoff notes — working docs, not repo history
HANDOFF-*.md
# Local agent instructions. Deliberately untracked: they describe THIS machine's
# checkout and deployment, not the project. Listed so they cannot be committed
# by accident once the repo is public. AGENTS.md is the real file; CLAUDE.md is
# a symlink to it.
AGENTS.md
CLAUDE.md

# session scratch: build/test baselines captured during execution
.baseline*.txt

# Written by the deploy sender into the tarball, never committed: it names the
# commit a release tree was built from, which a checkout answers from its repo.
RELEASE

# Run output: audit db, session logs and delivered reports.
.helium-state/

# Playwright MCP session scratch: console logs and page snapshots, tens of MB
# per browsing session, regenerated on demand.
.playwright-mcp/

# Generated by the tool-restriction contract before it installs the fixture:
# the dsh version pins (see contracts/src/dsh.ts dshOverridesYaml) and the
# lockfile that install writes. Derived from PINNED_DSH_VERSION, never edited.
contracts/fixtures/plugin-restrict-proof/pnpm-workspace.yaml
contracts/fixtures/plugin-restrict-proof/pnpm-lock.yaml
